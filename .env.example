# Ejemplo: configura variables de entorno en Windows (PowerShell)
CANJES_SQL_SERVER=servidor.database.windows.net
CANJES_SQL_DATABASE=nombre_base
CANJES_SQL_USER=usuario_lectura
CANJES_SQL_VIEW=ETL.VW_REGISTRO_REPORTE_CANJE_SELL_OUT_BI
CANJES_OUTLOOK_SENDER=reportes@ejemplo.com
CANJES_KEYRING_SERVICE=Automatizador Canjes
CANJES_BATCH_SIZE=10000
